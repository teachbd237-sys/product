# Local development-এর জন্য এই ফাইলের নাম .env করে সঠিক value বসাও
# .env ফাইলটি কখনো GitHub-এ Upload করবে না (এটা .gitignore-এ আছে)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# নিচের দুইটা শুধুমাত্র Netlify Functions ব্যবহার করে (Frontend-এ কখনো যায় না)
# SERVICE_ROLE_KEY অত্যন্ত গোপনীয়! কখনো GitHub-এ Upload করবে না, কাউকে দেখাবে না।
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
